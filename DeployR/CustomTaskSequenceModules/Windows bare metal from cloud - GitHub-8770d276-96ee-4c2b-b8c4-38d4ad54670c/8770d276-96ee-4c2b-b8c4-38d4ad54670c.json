ff-8d8b159b1dac","name":"Software","description":"","typeId":null,"type":null,"stepDefinitionVersionId":null,"stepDefinitionVersionNo":null,"typeVersion":null,"groupId":null,"groupMembers":[{"id":"04c191eb-b893-4337-5f3d-08de07628045","taskSequenceVersionId":null,"name":"App - Install M365 Apps - Office","description":"","typeId":"753771ea-0a3b-4e34-9931-301e0971c3c3","type":null,"stepDefinitionVersionId":"c28d84fc-b3f4-4d47-bb7d-27685904de0b","stepDefinitionVersionNo":1,"typeVersion":null,"groupId":"aadebfab-582c-43bd-5f3c-08de07628045","groupMembers":[],"settings":{"scriptName":"Install-M365Apps.ps1","M365OfficeSuites":"","M365Visio":"None","M365Project":"None","M365AccessRuntime":"false","M365Channel":"Current","M365Access":"false","M365OutlookClassic":"false","M365OutlookNew":"true","M365OneNote":"true","M365Publisher":"false","M365PowerPoint":"true","M365Skype":"false","M365CompanyValue":"2Pint Labs","M365OfficeDeployToolKitURL":"https://download.microsoft.com/download/6c1eeb25-cf8b-41d9-8d0d-cc1dbc032140/officedeploymenttool_19029-20136.exe"},"contentItems":{"content":"d819ff51-72a1-4e3c-bdf3-fcb69cf1bbab:1"},"isGroup":false,"continueOnError":false,"enabled":true,"condition":null,"createdDate":1760042321,"lastModifiedDate":1760042321},{"id":"e52049ca-ee27-470f-5f3e-08de07628045","taskSequenceVersionId":null,"name":"Apps - Install VSCode from Cloud","description":"","typeId":"00000001-0000-0000-0000-000000000002","type":null,"stepDefinitionVersionId":"5f666533-9e61-407c-f8bb-08dc9ff6a5e9","stepDefinitionVersionNo":1,"typeVersion":null,"groupId":"aadebfab-582c-43bd-5f3c-08de07628045","groupMembers":[],"settings":{"ScriptName":"","Script":"# Define variables\r\n$downloadUrl = \"https://code.visualstudio.com/sha/download?build=stable&os=win32-x64\"\r\n$installerPath = \"$env:TEMP\\VSCodeSetup.exe\"\r\n$logPath = \"$env:TEMP\\VSCodeInstall.log\"\r\n\r\ntry {\r\n    # Attempt download with Start-BitsTransfer\r\n    Write-Host \"Attempting to download VS Code installer using BITS...\"\r\n    try {\r\n        Start-BitsTransfer -Source $downloadUrl -Destination $installerPath -ErrorAction Stop\r\n    }\r\n    catch {\r\n        Write-Host \"BITS download failed, falling back to Invoke-WebRequest...\" -ForegroundColor Yellow\r\n        Invoke-WebRequest -Uri $downloadUrl -OutFile $installerPath -ErrorAction Stop\r\n    }\r\n\r\n    # Install VS Code silently\r\n    Write-Host \"Installing VS Code...\"\r\n    Start-Process -FilePath $installerPath -ArgumentList \"/VERYSILENT /NORESTART /MERGETASKS=!runcode /LOG=$logPath\" -Wait -ErrorAction Stop\r\n\r\n    Write-Host \"VS Code installed successfully.\"\r\n}\r\ncatch {\r\n    Write-Host \"Error occurred: $_\" -ForegroundColor Red\r\n}\r\nfinally {\r\n    # Clean up\r\n    if (Test-Path $installerPath) {\r\n        Remove-Item -Path $installerPath -Force -ErrorAction SilentlyContinue\r\n    }\r\n}","Parameters":"","Timeout":"15"},"contentItems":{"Content":""},"isGroup":false,"continueOnError":false,"enabled":true,"condition":null,"createdDate":1760042321,"lastModifiedDate":1760042321},{"id":"68170d4c-b6eb-4081-5f3f-08de07628045","taskSequenceVersionId":null,"name":"Apps - Install WMI Explorer","description":"","typeId":"f773b057-22c4-4a8e-bbcc-a98919189b9e","type":null,"stepDefinitionVersionId":"e2208a42-3bda-42ec-891e-f85b96591fba","stepDefinitionVersionNo":1,"typeVersion":null,"groupId":"aadebfab-582c-43bd-5f3c-08de07628045","groupMembers":[],"settings":{"WMIEFromCloud":"true","scriptName":"Install-WMIExplorer.ps1"},"contentItems":{"content":"d819ff51-72a1-4e3c-bdf3-fcb69cf1bbab:1","WMIEContentItem":""},"isGroup":false,"continueOnError":false,"enabled":true,"condition":null,"createdDate":1760042321,"lastModifiedDate":1760042321},{"id":"905f476f-6bbe-4e58-747a-08de07714afa","taskSequenceVersionId":null,"name":"Extra Apps Module","description":"","typeId":"00000001-0000-0000-0000-00000000000d","type":null,"stepDefinitionVersionId":"3fb5489a-856e-468e-89df-b64643868e22","stepDefiniti